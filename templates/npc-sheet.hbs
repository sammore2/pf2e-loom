{{!-- PF2E — npc-sheet.hbs — arsenal heráldico em coluna única: topo, PV, defesas com selo, atributos, golpes, ações, perícias, notas --}}
<div class="pf2e-panel tat-hud tat-npc">
  <header class="tat-top">
    <button type="button" class="tat-portrait" data-action="pick-portrait" title="{{localize "pf2e.sheets.portrait"}}">
      <img src="{{avatarUrl}}" alt="{{name}}" onerror="this.src='/marketplace/rulesets/pf2e/assets/images/default-avatar.svg'" />
    </button>
    <div class="tat-id">
      <input class="tat-in tat-name" type="text" name="name" value="{{name}}" placeholder="{{localize "pf2e.sheets.name"}}" />
      <div class="tat-id-line"><span>{{localize "pf2e.sheets.level"}} {{level}}</span></div>
    </div>
    <label class="tat-level" title="{{localize "pf2e.sheets.level"}}">
      <span>{{localize "pf2e.sheets.level"}}</span>
      <input class="tat-in" type="number" name="sd:level" value="{{level}}" min="1" max="20" />
    </label>
  </header>

  <div class="tat-tile tat-hp{{#if hp.low}} is-low{{/if}}">
    <span class="tat-label">{{localize "pf2e.sheets.hp"}}</span>
    <div class="tat-hp-read">
      <input class="tat-in tat-hp-cur" type="number" name="sd:hp.value" value="{{hp.value}}" />
      <span class="tat-hp-max">/ <input class="tat-in tat-in-sm" type="number" name="sd:hp.max" value="{{hp.max}}" /></span>
      <label class="tat-hp-temp">{{localize "pf2e.sheets.temp"}} <input class="tat-in tat-in-sm" type="number" name="sd:hp.temp" value="{{hp.temp}}" /></label>
    </div>
    <div class="tat-meter"><span style="width: {{hp.pct}}%"></span></div>
  </div>

  <section class="tat-defenses">
    {{#each defTiles}}
    <div class="tat-tile tat-def{{#if big}} tat-def-ac{{/if}}">
      <span class="tat-rank rank-{{rank}}">
        <button type="button" class="tat-seal" data-action="rank-seal" title="{{localize (concat "pf2e.ranks." rank)}}">{{rank}}</button>
        <select class="tat-in rank-select" name="sd:{{path}}" style="display:none">{{#each rankOptions}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{value}}</option>{{/each}}</select>
      </span>
      {{#if roll}}
      <button type="button" class="tat-def-value tat-roll" data-action="{{roll}}" data-key="{{key}}" title="{{localize labelKey}}">{{value}}</button>
      {{else}}
      <strong class="tat-def-value" title="{{localize labelKey}}">{{value}}</strong>
      {{/if}}
      <span class="tat-def-name">{{localize shortKey}}</span>
    </div>
    {{/each}}
  </section>

  <section class="tat-block">
    <h3 class="tat-label">{{localize "pf2e.sheets.attributes"}}</h3>
    <div class="tat-attrs">
      {{#each abilities}}
      <div class="tat-attr-cell">
        <button type="button" class="tat-attr-key" data-action="roll-attribute" data-key="{{key}}" title="{{localize labelKey}}">{{localize (concat "pf2e.sheets.abbr." key)}}</button>
        <input class="tat-in tat-attr-mod" type="number" name="sd:abilities.{{key}}.value" value="{{mod}}" title="{{localize labelKey}}" />
      </div>
      {{/each}}
    </div>
  </section>

  <section class="tat-block tat-strikes">
    <h3 class="tat-label">{{localize "pf2e.sheets.strikes"}}</h3>
    {{#each weapons}}
    <div class="tat-strike" data-id="{{id}}">
      <div class="tat-strike-head">
        <button type="button" class="tat-strike-name" data-action="item-open" data-id="{{id}}">{{name}}</button>
        {{#if agile}}<span class="tat-tag">{{localize "pf2e.sheets.agile"}}</span>{{/if}}
        <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="×"><i class="fa-solid fa-trash"></i></button>
      </div>
      <div class="tat-ladder">
        <button type="button" class="tat-rung" data-action="roll-attack" data-id="{{id}}" data-index="0" title="{{localize "pf2e.sheets.attackN.0"}}">{{atk.[0]}}</button>
        <button type="button" class="tat-rung" data-action="roll-attack" data-id="{{id}}" data-index="1" title="{{localize "pf2e.sheets.attackN.1"}}">{{atk.[1]}}</button>
        <button type="button" class="tat-rung" data-action="roll-attack" data-id="{{id}}" data-index="2" title="{{localize "pf2e.sheets.attackN.2"}}">{{atk.[2]}}</button>
      </div>
      <div class="tat-strike-damage">
        <button type="button" class="tat-roll" data-action="roll-damage" data-id="{{id}}" title="{{localize "pf2e.sheets.damage"}}"><i class="fa-solid fa-burst"></i> {{#if damage}}{{damage}}{{else}}{{localize "pf2e.sheets.damage"}}{{/if}}</button>
        <button type="button" class="tat-roll tat-crit" data-action="roll-damage-crit" data-id="{{id}}" title="{{localize "pf2e.sheets.crit"}}">×2</button>
      </div>
    </div>
    {{else}}
    <p class="tat-empty">{{localize "pf2e.sheets.noWeapons"}}</p>
    {{/each}}
    {{#each actionItems}}
    <div class="tat-actionrow" data-id="{{id}}">
      <span class="tat-cost">{{actions}}</span>
      <button type="button" class="tat-link" data-action="item-open" data-id="{{id}}">{{name}}</button>
      <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="×"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
    <div class="tat-adds">
      <button type="button" class="tat-add" data-action="item-create" data-type="weapon"><i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addWeapon"}}</button>
      <button type="button" class="tat-add" data-action="item-create" data-type="action"><i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addAction"}}</button>
    </div>
  </section>

  {{#if skills}}
  <section class="tat-block">
    <h3 class="tat-label">{{localize "pf2e.sheets.tabs.skills"}}</h3>
    <div class="tat-skill-list">
      {{#each skills}}
      <div class="tat-skill">
        <span class="tat-rank rank-{{rank}}"><span class="tat-seal" title="{{localize (concat "pf2e.ranks." rank)}}">{{rank}}</span></span>
        <button type="button" class="tat-skill-roll" data-action="roll-skill" data-key="{{key}}">
          <span class="tat-skill-name">{{localize labelKey}}</span><b>{{total}}</b>
        </button>
      </div>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <textarea class="tat-in tat-notes" name="sd:details.biography" placeholder="{{localize "pf2e.sheets.notesPlaceholder"}}">{{biography}}</textarea>
</div>

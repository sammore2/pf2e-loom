{{!-- PF2E — Party Sheet: Hub Tático do Grupo & Roster de Integrantes --}}
<div class="pf2e-panel tat-hud pf2e-party-sheet">

  {{!-- Top Header: Party Name, Level Avg, Shared Stash --}}
  <header class="pf2e-party-header">
    <div class="pf2e-party-id-card tat-block">
      <span class="tat-label"><i class="fa-solid fa-users"></i> {{localize "pf2e.sheets.partyName"}}</span>
      <div class="party-name-row">
        <input class="tat-in tat-party-name-input" type="text" name="name" value="{{name}}" placeholder="{{localize "pf2e.party.placeholderName"}}" title="{{localize "pf2e.party.renameTitle"}}" />
      </div>
      <div class="tat-id-line">
        <span><i class="fa-solid fa-user-group"></i> {{memberCount}} {{localize "pf2e.party.members"}}</span>
        <span class="tat-sep">·</span>
        <span>{{localize "pf2e.party.avgLevelLabel"}}: <b>{{averageLevel}}</b></span>
      </div>
    </div>

    {{!-- Shared Party Wealth Stash --}}
    <div class="pf2e-party-stash tat-block" title="{{localize "pf2e.party.stashTooltip"}}">
      <span class="tat-label"><i class="fa-solid fa-coins"></i> {{localize "pf2e.party.stash"}}</span>
      <div class="pf2e-stash-coins">
        <label class="coin-field" title="Platina">
          <span class="coin-tag coin-pp">PP</span>
          <input class="tat-in" type="number" name="sd:stash.pp" value="{{stash.pp}}" min="0" />
        </label>
        <label class="coin-field" title="Ouro">
          <span class="coin-tag coin-gp">PO</span>
          <input class="tat-in" type="number" name="sd:stash.gp" value="{{stash.gp}}" min="0" />
        </label>
        <label class="coin-field" title="Prata">
          <span class="coin-tag coin-sp">PE</span>
          <input class="tat-in" type="number" name="sd:stash.sp" value="{{stash.sp}}" min="0" />
        </label>
        <label class="coin-field" title="Cobre">
          <span class="coin-tag coin-cp">PC</span>
          <input class="tat-in" type="number" name="sd:stash.cp" value="{{stash.cp}}" min="0" />
        </label>
      </div>
    </div>
  </header>

  <nav class="tat-tabs">
    <button type="button" class="pf2e-tab-btn active" data-action="tab" data-tab="roster" title="{{localize "pf2e.party.roster"}}">
      <i class="fa-solid fa-users-viewfinder"></i> {{localize "pf2e.party.roster"}}
    </button>
    <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="inventory" title="{{localize "pf2e.party.inventory"}}">
      <i class="fa-solid fa-box-archive"></i> {{localize "pf2e.party.inventory"}}
    </button>
    <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="notes" title="{{localize "pf2e.party.notes"}}">
      <i class="fa-solid fa-feather-pointed"></i> {{localize "pf2e.party.notes"}}
    </button>
  </nav>

  {{!-- ═══ Roster Tab ═══ --}}
  <div class="tat-panel tat-party-roster" data-tab-content="roster">
    <div class="pf2e-party-roster-head">
      <h3 class="tat-label">{{localize "pf2e.party.rosterHead"}}</h3>
      <div class="pf2e-party-add-wrap">
        {{#if availableActors.length}}
        <select class="tat-in pf2e-party-actor-select" data-action="member-add-select">
          <option value="">{{localize "pf2e.party.linkMember"}}</option>
          {{#each availableActors}}
          <option value="{{id}}">{{name}} ({{localize "pf2e.sheets.level"}} {{systemData.level}})</option>
          {{/each}}
        </select>
        {{/if}}
      </div>
    </div>

    <div class="pf2e-party-members-grid">
      {{#each members}}
      <div class="pf2e-party-member-card tat-block" data-id="{{id}}">
        <div class="member-card-main">
          <button type="button" class="member-portrait" data-action="open-actor-sheet" data-id="{{id}}" title="{{name}}">
            <img src="{{avatarUrl}}" alt="{{name}}" onerror="this.src='/marketplace/rulesets/pf2e/assets/images/default-avatar.svg'" />
          </button>
          <div class="member-info">
            <div class="member-name-row">
              <button type="button" class="member-name-btn" data-action="open-actor-sheet" data-id="{{id}}">{{name}}</button>
              <span class="member-lvl">{{localize "pf2e.sheets.level"}} {{level}}</span>
            </div>
            <div class="member-class-line">{{ancestryClass}}</div>
            
            {{!-- Member HP Bar --}}
            <div class="member-vitals">
              <div class="member-hp-row">
                <span class="tat-label">{{localize "pf2e.sheets.hp"}}</span>
                <span class="member-hp-vals"><b>{{hp.value}}</b> / {{hp.max}}{{#if hp.temp}} (+{{hp.temp}}){{/if}}</span>
              </div>
              <div class="tat-meter"><span style="width: {{hp.pct}}%"></span></div>
            </div>
          </div>
        </div>

        {{!-- Quick Passive Defenses --}}
        <div class="member-defenses-strip">
          <div class="member-def-tile" title="{{localize "pf2e.defenses.ac"}}">
            <span class="tat-label">{{localize "pf2e.sheets.short.ac"}}</span>
            <b>{{ac}}</b>
          </div>
          <div class="member-def-tile" title="{{localize "pf2e.defenses.perception"}}">
            <span class="tat-label">{{localize "pf2e.sheets.short.perception"}}</span>
            <b>{{perception}}</b>
          </div>
          <div class="member-def-tile" title="{{localize "pf2e.defenses.fortitude"}}">
            <span class="tat-label">{{localize "pf2e.saves.fortitudeAbbr"}}</span>
            <b>{{saves.fortitude}}</b>
          </div>
          <div class="member-def-tile" title="{{localize "pf2e.defenses.reflex"}}">
            <span class="tat-label">{{localize "pf2e.saves.reflexAbbr"}}</span>
            <b>{{saves.reflex}}</b>
          </div>
          <div class="member-def-tile" title="{{localize "pf2e.defenses.will"}}">
            <span class="tat-label">{{localize "pf2e.saves.willAbbr"}}</span>
            <b>{{saves.will}}</b>
          </div>
        </div>

        {{!-- Exploration Activity & Controls --}}
        <div class="member-exploration-bar">
          <label class="member-activity-label">
            <span class="tat-label"><i class="fa-solid fa-compass"></i> {{localize "pf2e.sheets.exploration"}}:</span>
            <select class="tat-in member-activity-select" data-action="set-exploration-activity" data-id="{{id}}">
              {{#each explorationOptions}}
              <option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <button type="button" class="tat-icon member-remove-btn" data-action="member-remove" data-id="{{id}}" title="{{localize "pf2e.party.removeMember"}}">
            <i class="fa-solid fa-user-minus"></i>
          </button>
        </div>
      </div>
      {{else}}
      <div class="tat-empty pf2e-party-empty">
        <i class="fa-solid fa-users-slash"></i>
        <p>{{localize "pf2e.party.noMembers"}}</p>
      </div>
      {{/each}}
    </div>
  </div>

  {{!-- ═══ Party Inventory Tab ═══ --}}
  <div class="tat-panel" data-tab-content="inventory">
    <section class="tat-block">
      <h3 class="tat-label">{{localize "pf2e.party.itemsTitle"}}</h3>
      {{#each items}}
      <div class="tat-actionrow" data-id="{{id}}">
        <button type="button" class="tat-link" data-action="item-open" data-id="{{id}}">{{name}}</button>
        <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="×"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{else}}
      <p class="tat-empty">{{localize "pf2e.party.emptyStash"}}</p>
      {{/each}}
      <button type="button" class="tat-add" data-action="item-create" data-type="equipment"><i class="fa-solid fa-plus"></i> {{localize "pf2e.party.addItem"}}</button>
    </section>
  </div>

  {{!-- ═══ Notes Tab ═══ --}}
  <div class="tat-panel" data-tab-content="notes">
    <textarea class="tat-in tat-notes" name="sd:notes" placeholder="{{localize "pf2e.party.notesPlaceholder"}}">{{notes}}</textarea>
  </div>

</div>

{{!-- PF2E — Compendium Browser --}}
<div class="pf2e-panel tat-hud pf2e-browser-panel">

  {{!-- Top Filter Bar --}}
  <header class="pf2e-browser-header">
    <div class="pf2e-browser-search-wrap">
      <i class="fa-solid fa-magnifying-glass pf2e-search-icon"></i>
      <input type="text" class="tat-in pf2e-browser-search" placeholder="{{localize "pf2e.browser.searchPlaceholder"}}" value="{{searchQuery}}" data-action="filter-search" />
      {{#if searchQuery}}
      <button type="button" class="tat-icon pf2e-search-clear" data-action="clear-search" title="{{localize "pf2e.browser.clearSearch"}}"><i class="fa-solid fa-xmark"></i></button>
      {{/if}}
    </div>

    <nav class="pf2e-browser-tabs">
      <button type="button" class="pf2e-tab-btn{{#if (eq activeTab "all")}} active{{/if}}" data-action="tab" data-tab="all">
        <i class="fa-solid fa-layer-group"></i> {{localize "pf2e.browser.all"}} ({{counts.all}})
      </button>
      <button type="button" class="pf2e-tab-btn{{#if (eq activeTab "action")}} active{{/if}}" data-action="tab" data-tab="action">
        <i class="fa-solid fa-bolt"></i> {{localize "pf2e.browser.action"}} ({{counts.action}})
      </button>
      <button type="button" class="pf2e-tab-btn{{#if (eq activeTab "equipment")}} active{{/if}}" data-action="tab" data-tab="equipment">
        <i class="fa-solid fa-shield-halved"></i> {{localize "pf2e.browser.equipment"}} ({{counts.equipment}})
      </button>
      <button type="button" class="pf2e-tab-btn{{#if (eq activeTab "spell")}} active{{/if}}" data-action="tab" data-tab="spell">
        <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "pf2e.browser.spell"}} ({{counts.spell}})
      </button>
      <button type="button" class="pf2e-tab-btn{{#if (eq activeTab "feat")}} active{{/if}}" data-action="tab" data-tab="feat">
        <i class="fa-solid fa-award"></i> {{localize "pf2e.browser.feat"}} ({{counts.feat}})
      </button>
    </nav>
  </header>

  {{!-- Main 2-column view: Left item list, Right detail inspector --}}
  <div class="pf2e-browser-body">

    {{!-- Item List column --}}
    <div class="pf2e-browser-list">
      {{#each items}}
      <div class="pf2e-browser-row{{#if isSelected}} is-selected{{/if}}" data-id="{{id}}" data-action="select-item" draggable="true">
        <div class="pf2e-browser-row-left">
          <span class="pf2e-glyph-cost">{{glyphCost}}</span>
          <span class="pf2e-row-name">{{name}}</span>
        </div>
        <div class="pf2e-browser-row-right">
          <div class="pf2e-row-traits">
            {{#each traits}}<span class="tat-tag">{{this}}</span>{{/each}}
          </div>
          <span class="pf2e-row-type-badge">{{typeLabel}}</span>
          <button type="button" class="tat-add pf2e-row-add-btn" data-action="add-to-sheet" data-id="{{id}}" title="{{localize "pf2e.browser.addToSheet"}}">
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>
      </div>
      {{else}}
      <div class="tat-empty pf2e-browser-empty">
        <i class="fa-solid fa-box-open"></i> {{localize "pf2e.browser.noResults"}}
      </div>
      {{/each}}
    </div>

    {{!-- Detail inspector column --}}
    <aside class="pf2e-browser-detail tat-block">
      {{#if selectedItem}}
      <div class="pf2e-detail-head">
        <div class="pf2e-detail-title-line">
          <h2 class="pf2e-detail-title">{{selectedItem.name}}</h2>
          <span class="pf2e-glyph-cost pf2e-detail-cost">{{selectedItem.glyphCost}}</span>
        </div>
        <div class="pf2e-detail-meta">
          <span class="tat-label">{{selectedItem.typeLabel}}</span>
          {{#if selectedItem.level}}<span class="tat-tag">{{localize "pf2e.sheets.level"}} {{selectedItem.level}}</span>{{/if}}
          {{#if selectedItem.rank}}<span class="tat-tag">{{localize "pf2e.sheets.rank"}} {{selectedItem.rank}}</span>{{/if}}
          {{#if selectedItem.price}}<span class="tat-tag">{{selectedItem.price}}</span>{{/if}}
        </div>
        <div class="pf2e-detail-traits">
          {{#each selectedItem.traits}}
          <span class="tat-tag tat-tag-trait">{{this}}</span>
          {{/each}}
        </div>
      </div>

      <div class="pf2e-detail-body">
        {{#if selectedItem.damage}}
        <div class="pf2e-detail-stat-row">
          <span class="tat-label">{{localize "pf2e.sheets.damage"}}:</span>
          <b>{{selectedItem.damage}} {{selectedItem.damageType}}</b>
        </div>
        {{/if}}
        {{#if selectedItem.acBonus}}
        <div class="pf2e-detail-stat-row">
          <span class="tat-label">{{localize "pf2e.sheets.acBonus"}}:</span>
          <b>+{{selectedItem.acBonus}}</b>
          {{#if selectedItem.dexCap}}<span class="tat-dim">({{localize "pf2e.sheets.dexCap"}}: +{{selectedItem.dexCap}})</span>{{/if}}
        </div>
        {{/if}}
        {{#if selectedItem.save}}
        <div class="pf2e-detail-stat-row">
          <span class="tat-label">{{localize "pf2e.sheets.save"}}:</span>
          <b>{{selectedItem.save}}</b>
        </div>
        {{/if}}

        <div class="pf2e-detail-desc">
          <p>{{selectedItem.description}}</p>
        </div>
      </div>

      <div class="pf2e-detail-actions">
        <button type="button" class="tat-add pf2e-detail-add-btn" data-action="add-to-sheet" data-id="{{selectedItem.id}}">
          <i class="fa-solid fa-plus"></i> {{localize "pf2e.browser.addToSheet"}}
        </button>
      </div>
      {{else}}
      <div class="tat-empty pf2e-detail-placeholder">
        <i class="fa-solid fa-hand-pointer"></i>
        <p>{{localize "pf2e.browser.selectItemPrompt"}}</p>
      </div>
      {{/if}}
    </aside>

  </div>
</div>

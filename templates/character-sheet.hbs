            </div>
            {{else}}
            <div class="tat-empty pf2e-actions-empty">
              <span>{{localize "pf2e.sheets.noReactions"}}</span>
            </div>
            {{/each}}
          </div>
        </section>

        {{!-- Free Actions Section --}}
        <section class="tat-block pf2e-actions-block">
          <div class="pf2e-block-head">
            <h3 class="tat-label">{{localize "pf2e.sheets.freeActions"}}</h3>
            <div class="pf2e-head-btns">
              <button type="button" class="tat-btn-xs" data-action="item-create" data-type="action" data-cost="free">
                <i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.createFreeAction"}}
              </button>
              <button type="button" class="tat-btn-xs pf2e-browser-launch-btn" data-action="open-compendium" data-tab="actions">
                <i class="fa-solid fa-book"></i> {{localize "pf2e.sheets.browse"}}
              </button>
            </div>
          </div>
          <div class="pf2e-actions-list">
            {{#each freeActions}}
            <div class="pf2e-action-item-card" data-id="{{id}}">
              <button type="button" class="pf2e-glyph-box glyph-free" data-action="action-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">◇</button>
              <div class="pf2e-action-details">
                <button type="button" class="pf2e-action-name" data-action="action-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{name}}</button>
                {{#if traits.length}}
                <div class="pf2e-action-traits">{{#each traits}}<span class="tat-tag">{{this}}</span>{{/each}}</div>
                {{/if}}
              </div>
              <div class="pf2e-action-tools">
                <button type="button" class="tat-icon" data-action="action-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}"><i class="fa-solid fa-message"></i></button>
                <button type="button" class="tat-icon" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}"><i class="fa-solid fa-pen-to-square"></i></button>
                <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-trash"></i></button>
              </div>
            </div>
            {{else}}
            <div class="tat-empty pf2e-actions-empty">
              <span>{{localize "pf2e.sheets.noFreeActions"}}</span>
            </div>
            {{/each}}
          </div>
        </section>
      </div>

      {{!-- SUB-MODE: EXPLORATION --}}
      <div class="pf2e-action-mode-content" data-action-mode-content="exploration" style="display:none">
        <section class="tat-block pf2e-actions-block pf2e-active-exploration-block">
          <div class="pf2e-exploration-selector-row">
            <span class="tat-label"><i class="fa-solid fa-compass"></i> {{localize "pf2e.sheets.activeExploration"}}:</span>
            <select class="tat-in pf2e-exploration-select" name="sd:explorationActivity">
              {{#each explorationOptions}}
              <option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>
        </section>

        <section class="tat-block pf2e-actions-block">
          <div class="pf2e-block-head">
            <h3 class="tat-label">{{localize "pf2e.sheets.explorationActivities"}}</h3>
            <button type="button" class="tat-btn-xs pf2e-browser-launch-btn" data-action="open-compendium" data-tab="actions">
              <i class="fa-solid fa-book"></i> {{localize "pf2e.sheets.browse"}}
            </button>
          </div>
          <div class="pf2e-actions-list">
            {{#each explorationActivities}}
            <div class="pf2e-action-item-card is-standard" data-action-key="{{id}}">
              <button type="button" class="pf2e-glyph-box glyph-act" data-action="standard-action-chat" data-action-key="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{glyph}}</button>
              <div class="pf2e-action-details">
                <button type="button" class="pf2e-action-name" data-action="standard-action-chat" data-action-key="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{name}}</button>
                <p class="pf2e-action-desc">{{desc}}</p>
              </div>
              <div class="pf2e-action-tools">
                <button type="button" class="tat-icon" data-action="standard-action-chat" data-action-key="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}"><i class="fa-solid fa-message"></i></button>
              </div>
            </div>
            {{/each}}
          </div>
        </section>
      </div>

      {{!-- SUB-MODE: DOWNTIME --}}
      <div class="pf2e-action-mode-content" data-action-mode-content="downtime" style="display:none">
        <section class="tat-block pf2e-actions-block">
          <div class="pf2e-block-head">
            <h3 class="tat-label">{{localize "pf2e.sheets.downtimeActivities"}}</h3>
            <button type="button" class="tat-btn-xs pf2e-browser-launch-btn" data-action="open-compendium" data-tab="actions">
              <i class="fa-solid fa-book"></i> {{localize "pf2e.sheets.browse"}}
            </button>
          </div>
          <div class="pf2e-actions-list">
            {{#each downtimeActivities}}
            <div class="pf2e-action-item-card is-standard" data-action-key="{{id}}">
              <button type="button" class="pf2e-glyph-box glyph-std" data-action="standard-action-chat" data-action-key="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{glyph}}</button>
              <div class="pf2e-action-details">
                <button type="button" class="pf2e-action-name" data-action="standard-action-chat" data-action-key="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{name}}</button>
                <p class="pf2e-action-desc">{{desc}}</p>
              </div>
              <div class="pf2e-action-tools">
                <button type="button" class="tat-icon" data-action="standard-action-chat" data-action-key="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}"><i class="fa-solid fa-message"></i></button>
              </div>
            </div>
            {{/each}}
          </div>
        </section>
      </div>
    </div>

    {{!-- ═══ 3. COMBAT TAB (TURNO & GOLPES TÁTICOS) ═══ --}}
    <div class="tat-panel tat-combat" data-tab-content="combat">
      {{!-- Turn Action Console --}}
      <section class="tat-block tat-turn-bar">
        <div class="tat-turn-inner">
          <div class="tat-console">
            <span class="tat-label">{{localize "pf2e.sheets.turn"}}</span>
            <div class="tat-pips">
              <button type="button" class="tat-pip pf2e-action-pip" data-action="action-pip" data-idx="0" title="{{localize "pf2e.sheets.action"}} 1">◆</button>
              <button type="button" class="tat-pip pf2e-action-pip" data-action="action-pip" data-idx="1" title="{{localize "pf2e.sheets.action"}} 2">◆</button>
              <button type="button" class="tat-pip pf2e-action-pip" data-action="action-pip" data-idx="2" title="{{localize "pf2e.sheets.action"}} 3">◆</button>
              <button type="button" class="tat-pip tat-pip-react pf2e-reaction-pip" data-action="reaction-pip" title="{{localize "pf2e.sheets.reaction"}}">↺</button>
            </div>
            <button type="button" class="tat-newturn" data-action="new-turn" title="{{localize "pf2e.sheets.newTurn"}}"><i class="fa-solid fa-rotate-left"></i> {{localize "pf2e.sheets.newTurn"}}</button>
          </div>
        </div>
      </section>

      {{!-- Combat Strikes --}}
      <section class="tat-block tat-strikes pf2e-attacks-block">
        <div class="pf2e-block-head">
          <h3 class="tat-label">{{localize "pf2e.sheets.strikes"}}</h3>
          <button type="button" class="tat-btn-xs" data-action="item-create" data-type="weapon" title="{{localize "pf2e.sheets.addStrike"}}">
            <i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addWeapon"}}
          </button>
        </div>
        {{#each weapons}}
        <div class="tat-strike pf2e-strike-card" data-id="{{id}}">
          <div class="tat-strike-head">
            <div class="tat-strike-title-group">
              <span class="tat-strike-cost">{{actions}}</span>
              {{#if (eq id "__unarmed__")}}
              <strong class="tat-strike-name">{{name}}</strong>
              {{else}}
              <button type="button" class="tat-strike-name" data-action="item-open" data-id="{{id}}">{{name}}</button>
              {{/if}}
            </div>
            <div class="tat-strike-traits">
              {{#each traits}}<span class="tat-tag">{{this}}</span>{{/each}}
            </div>
            <div class="tat-strike-tools">
              <button type="button" class="tat-icon" data-action="item-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}"><i class="fa-solid fa-message"></i></button>
              {{#unless (eq id "__unarmed__")}}
              <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="×"><i class="fa-solid fa-trash"></i></button>
              {{/unless}}
            </div>
          </div>
          <div class="tat-ladder">
            <button type="button" class="tat-rung" data-action="roll-attack" data-id="{{id}}" data-index="0" title="{{localize "pf2e.sheets.attackN.0"}}">{{mapLabels.[0]}}</button>
            <button type="button" class="tat-rung" data-action="roll-attack" data-id="{{id}}" data-index="1" title="{{localize "pf2e.sheets.attackN.1"}}">{{mapLabels.[1]}}</button>
            <button type="button" class="tat-rung" data-action="roll-attack" data-id="{{id}}" data-index="2" title="{{localize "pf2e.sheets.attackN.2"}}">{{mapLabels.[2]}}</button>
          </div>
          <div class="tat-strike-damage">
            <button type="button" class="tat-roll tat-damage-btn" data-action="roll-damage" data-id="{{id}}" title="{{localize "pf2e.sheets.damage"}}"><i class="fa-solid fa-burst"></i> {{#if damage}}{{damage}}{{else}}{{localize "pf2e.sheets.damage"}}{{/if}}</button>
            <button type="button" class="tat-roll tat-crit" data-action="roll-damage-crit" data-id="{{id}}" title="{{localize "pf2e.sheets.crit"}}"><i class="fa-solid fa-skull"></i> ×2</button>
          </div>
        </div>
        {{/each}}
      </section>
    </div>

    {{!-- ═══ 4. SKILLS TAB (PERÍCIAS & SABERES) ═══ --}}
    <div class="tat-panel tat-skills-panel" data-tab-content="skills">
      <section class="tat-block tat-skills">
        <h3 class="tat-label">{{localize "pf2e.sheets.tabs.skills"}}</h3>
        <div class="tat-skill-grid">
          {{#each skills}}
          <div class="tat-skill" data-key="{{key}}">
            <button type="button" class="tat-skill-rank-badge rank-{{rank}}" data-action="cycle-skill-rank" data-key="{{key}}" title="{{rankLabel}} ({{localize (concat "pf2e.ranks." rank)}}) — {{localize "pf2e.sheets.cycleRank"}}">
              <span class="tat-seal">{{rank}}</span>
              <span class="pf2e-rank-pips">
                {{#each pips}}<span class="pip{{#if filled}} on{{/if}}"></span>{{/each}}
              </span>
            </button>
            <button type="button" class="tat-skill-roll" data-action="roll-skill" data-key="{{key}}" title="{{localize labelKey}}">
              <span class="tat-skill-name">{{localize labelKey}}</span>
              <b class="tat-skill-mod">{{total}}</b>
            </button>
          </div>
          {{/each}}
        </div>

        {{#if lore}}
        <div class="tat-lore-list">
          {{#each lore}}
          <div class="tat-skill tat-lore" data-name="{{name}}">
            <button type="button" class="tat-skill-rank-badge rank-{{rank}}" data-action="cycle-lore-rank" data-name="{{name}}" title="{{rankLabel}} — {{localize "pf2e.sheets.cycleRank"}}">
              <span class="tat-seal">{{rank}}</span>
              <span class="pf2e-rank-pips">
                {{#each pips}}<span class="pip{{#if filled}} on{{/if}}"></span>{{/each}}
              </span>
            </button>
            <button type="button" class="tat-skill-roll" data-action="roll-lore" data-name="{{name}}">
              <span class="tat-skill-name">{{name}}</span>
              <b class="tat-skill-mod">{{total}}</b>
            </button>
            <button type="button" class="tat-icon" data-action="lore-remove" data-name="{{name}}" title="×"><i class="fa-solid fa-xmark"></i></button>
          </div>
          {{/each}}
        </div>
        {{/if}}
        <div class="tat-lore-add">
          <input class="tat-in" type="text" name="new-lore-name" placeholder="{{localize "pf2e.sheets.lore"}}" />
          <button type="button" class="tat-add" data-action="lore-add" title="{{localize "pf2e.sheets.add"}}"><i class="fa-solid fa-plus"></i></button>
        </div>
      </section>
    </div>

    {{!-- ═══ 5. SPELLS TAB ═══ --}}
    <div class="tat-panel" data-tab-content="spells">
      <div class="tat-casting pf2e-spell-casting-bar">
        <div class="tat-tile tat-def">
          <strong class="tat-def-value">{{spellDC}}</strong>
          <span class="tat-def-name">{{localize "pf2e.sheets.spellDC"}}</span>
        </div>
        <div class="tat-tile tat-def">
          <button type="button" class="tat-def-value tat-roll" data-action="roll-spell-attack" title="{{localize "pf2e.sheets.rollSpellAttack"}}">{{spellAttack}}</button>
          <span class="tat-def-name">{{localize "pf2e.sheets.spellAttack"}}</span>
        </div>
      </div>
      {{#each spellsByRank}}
      <section class="tat-block pf2e-spell-rank-block">
        <h3 class="tat-label tat-label-row">{{localize "pf2e.sheets.rank"}} {{rank}}
          {{#if slots}}<span class="tat-slots"><input class="tat-in tat-in-sm" type="number" name="sd:spellSlots.{{rank}}.value" value="{{slots.value}}" /> / <input class="tat-in tat-in-sm" type="number" name="sd:spellSlots.{{rank}}.max" value="{{slots.max}}" /></span>{{/if}}
        </h3>
        {{#each items}}
        <div class="tat-actionrow" data-id="{{id}}">
          <span class="tat-cost pf2e-glyph-cost">{{actions}}</span>
          <button type="button" class="tat-link" data-action="item-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{name}}</button>
          <button type="button" class="tat-icon" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{/each}}
      </section>
      {{/each}}
      <button type="button" class="tat-add" data-action="item-create" data-type="spell"><i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addSpell"}}</button>
    </div>

    {{!-- ═══ 6. CRAFTING TAB (MANUFATURA & FÓRMULAS) ═══ --}}
    <div class="tat-panel tat-crafting-panel" data-tab-content="crafting">
      <section class="tat-block tat-crafting-header-block">
        <h3 class="tat-label">{{localize "pf2e.sheets.crafting"}}</h3>
        <div class="tat-craft-stats-grid">
          <div class="craft-stat-box">
            <span class="stat-lbl">{{localize "pf2e.sheets.craftingRank"}}</span>
            <span class="stat-val rank-badge">{{crafting.rankLabel}}</span>
          </div>
          <div class="craft-stat-box">
            <span class="stat-lbl">{{localize "pf2e.sheets.modifier"}}</span>
            <button type="button" class="tat-roll craft-roll-btn" data-action="roll-crafting" title="{{localize "pf2e.sheets.rollCrafting"}}">
              <i class="fa-solid fa-hammer"></i> <b>{{crafting.mod}}</b>
            </button>
          </div>
          <div class="craft-stat-box">
            <span class="stat-lbl">{{localize "pf2e.sheets.craftingDC"}}</span>
            <b class="stat-val dc-val">{{crafting.dc}}</b>
          </div>
          <div class="craft-stat-box">
            <span class="stat-lbl">{{localize "pf2e.sheets.infusedReagents"}}</span>
            <input class="tat-in tat-in-sm" type="number" name="sd:crafting.infusedReagents" value="{{crafting.infusedReagents}}" min="0" />
          </div>
        </div>
      </section>

      <section class="tat-block tat-formulas-block">
        <h3 class="tat-label">{{localize "pf2e.sheets.knownFormulas"}}</h3>
        {{#each crafting.formulas}}
        <div class="tat-actionrow" data-id="{{id}}">
          <span class="tat-cost">{{localize "pf2e.sheets.level"}} {{level}}</span>
          <button type="button" class="tat-link" data-action="item-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{name}}</button>
          <button type="button" class="tat-icon" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{else}}
        <p class="tat-empty">{{localize "pf2e.sheets.noFormulas"}}</p>
        {{/each}}
        <button type="button" class="tat-add" data-action="item-create" data-type="equipment"><i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addFormula"}}</button>
      </section>
    </div>

    {{!-- ═══ 7. FEATS TAB (TALENTOS AUTÊNTICOS DO PF2E) ═══ --}}
    <div class="tat-panel tat-grid-2" data-tab-content="feats">
      {{#each featCategories}}
      <section class="tat-block">
        <h3 class="tat-label">{{label}}</h3>
        {{#each items}}
        <div class="tat-actionrow" data-id="{{id}}">
          <button type="button" class="tat-link" data-action="item-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{name}}</button>
          {{#if sub}}<span class="tat-sub">{{sub}}</span>{{/if}}
          <button type="button" class="tat-icon" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{else}}
        <p class="tat-empty">—</p>
        {{/each}}
        <button type="button" class="tat-add" data-action="item-create" data-type="feat"><i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addFeat"}}</button>
      </section>
      {{/each}}
    </div>

    {{!-- ═══ 8. INVENTORY TAB ═══ --}}
    <div class="tat-panel tat-grid-2" data-tab-content="inventory">
      {{#each inventory}}
      <section class="tat-block">
        <h3 class="tat-label">{{localize labelKey}}</h3>
        {{#each items}}
        <div class="tat-actionrow" data-id="{{id}}">
          <button type="button" class="tat-link" data-action="item-open" data-id="{{id}}">{{name}}</button>
          <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="×"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{else}}
        <p class="tat-empty">—</p>
        {{/each}}
        <button type="button" class="tat-add" data-action="item-create" data-type="{{type}}"><i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.add"}}</button>
      </section>
      {{/each}}
    </div>

    {{!-- ═══ 9. NOTES TAB ═══ --}}
    <div class="tat-panel" data-tab-content="notes">
      <textarea class="tat-in tat-notes" name="sd:details.biography" placeholder="{{localize "pf2e.sheets.notesPlaceholder"}}">{{biography}}</textarea>
    </div>
  </div>
</div>


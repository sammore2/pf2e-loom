                  <i class="fa-solid fa-dice-d20"></i> {{localize "pf2e.rolls.roll"}}
                </button>
                <button type="button" class="tat-icon" data-action="standard-action-chat" data-action-key="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}"><i class="fa-solid fa-message"></i></button>
              </div>
            </div>
            {{/each}}
          </div>
        </section>
      </div>
    </div>

    {{!-- ═══ 3. COMBAT TAB (TURNO & GOLPES TÁTICOS) ═══ --}}
    <div class="tat-panel tat-combat" data-tab-content="combat">
      {{!-- Turn Action Console --}}
      <section class="tat-block tat-turn-bar">
        <div class="tat-turn-inner">
          <div class="tat-console">
            <span class="tat-label">{{localize "pf2e.sheets.turn"}}</span>
            <div class="tat-pips">
              <button type="button" class="tat-pip pf2e-action-pip" data-action="action-pip" data-idx="0" title="{{localize "pf2e.sheets.action"}} 1">◆</button>
              <button type="button" class="tat-pip pf2e-action-pip" data-action="action-pip" data-idx="1" title="{{localize "pf2e.sheets.action"}} 2">◆</button>
              <button type="button" class="tat-pip pf2e-action-pip" data-action="action-pip" data-idx="2" title="{{localize "pf2e.sheets.action"}} 3">◆</button>
              <button type="button" class="tat-pip tat-pip-react pf2e-reaction-pip" data-action="reaction-pip" title="{{localize "pf2e.sheets.reaction"}}">↺</button>
            </div>
            <button type="button" class="tat-newturn" data-action="new-turn" title="{{localize "pf2e.sheets.newTurn"}}"><i class="fa-solid fa-rotate-left"></i> {{localize "pf2e.sheets.newTurn"}}</button>
          </div>
        </div>
      </section>

      {{!-- Tactical Roll Options Toggles --}}
      <section class="tat-block pf2e-toggles-block">
        <div class="pf2e-toggles-bar">
          <span class="tat-label"><i class="fa-solid fa-crosshairs"></i> {{localize "pf2e.toggles.title"}}:</span>
          <div class="pf2e-toggle-chips">
            <button type="button" class="tat-pill-btn pf2e-toggle-btn{{#if rollOptions.offGuard}} is-active{{/if}}" data-action="toggle-roll-option" data-option="offGuard" title="{{localize "pf2e.toggles.offGuardHint"}}">
              <i class="fa-solid {{#if rollOptions.offGuard}}fa-circle-check{{else}}fa-circle{{/if}}"></i> {{localize "pf2e.toggles.offGuard"}}
            </button>
            <button type="button" class="tat-pill-btn pf2e-toggle-btn{{#if rollOptions.cover}} is-active{{/if}}" data-action="toggle-roll-option" data-option="cover" title="{{localize "pf2e.toggles.coverHint"}}">
              <i class="fa-solid {{#if rollOptions.cover}}fa-circle-check{{else}}fa-circle{{/if}}"></i> {{localize "pf2e.toggles.cover"}}
            </button>
            <button type="button" class="tat-pill-btn pf2e-toggle-btn{{#if rollOptions.flanking}} is-active{{/if}}" data-action="toggle-roll-option" data-option="flanking" title="{{localize "pf2e.toggles.flankingHint"}}">
              <i class="fa-solid {{#if rollOptions.flanking}}fa-circle-check{{else}}fa-circle{{/if}}"></i> {{localize "pf2e.toggles.flanking"}}
            </button>
          </div>
        </div>
      </section>

      {{!-- Combat Strikes --}}
      <section class="tat-block tat-strikes pf2e-attacks-block">
        <div class="pf2e-block-head">
          <h3 class="tat-label">{{localize "pf2e.sheets.strikes"}}</h3>
          <button type="button" class="tat-btn-xs" data-action="item-create" data-type="weapon" title="{{localize "pf2e.sheets.addStrike"}}">
            <i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addWeapon"}}
          </button>
        </div>
        {{#each weapons}}
        <div class="tat-strike pf2e-strike-card" data-id="{{id}}">
          <div class="tat-strike-head">
            <div class="tat-strike-title-group">
              <span class="tat-strike-cost">{{actions}}</span>
              {{#if (eq id "__unarmed__")}}
              <strong class="tat-strike-name">{{name}}</strong>
              {{else}}
              <button type="button" class="tat-strike-name" data-action="item-open" data-id="{{id}}">{{name}}</button>
              {{/if}}
            </div>
            <div class="tat-strike-traits">
              {{#each traits}}<span class="tat-tag">{{this}}</span>{{/each}}
            </div>
            <div class="tat-strike-tools">
              <button type="button" class="tat-icon" data-action="item-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}"><i class="fa-solid fa-message"></i></button>
              {{#unless (eq id "__unarmed__")}}
              <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="×"><i class="fa-solid fa-trash"></i></button>
              {{/unless}}
            </div>
          </div>
          <div class="tat-ladder">
            <button type="button" class="tat-rung" data-action="roll-attack" data-id="{{id}}" data-index="0" title="{{localize "pf2e.sheets.attackN.0"}}">{{mapLabels.[0]}}</button>
            <button type="button" class="tat-rung" data-action="roll-attack" data-id="{{id}}" data-index="1" title="{{localize "pf2e.sheets.attackN.1"}}">{{mapLabels.[1]}}</button>
            <button type="button" class="tat-rung" data-action="roll-attack" data-id="{{id}}" data-index="2" title="{{localize "pf2e.sheets.attackN.2"}}">{{mapLabels.[2]}}</button>
          </div>
          <div class="tat-strike-damage">
            <button type="button" class="tat-roll tat-damage-btn" data-action="roll-damage" data-id="{{id}}" title="{{localize "pf2e.sheets.damage"}}"><i class="fa-solid fa-burst"></i> {{#if damage}}{{damage}}{{else}}{{localize "pf2e.sheets.damage"}}{{/if}}</button>
            <button type="button" class="tat-roll tat-crit" data-action="roll-damage-crit" data-id="{{id}}" title="{{localize "pf2e.sheets.crit"}}"><i class="fa-solid fa-skull"></i> ×2</button>
          </div>
        </div>
        {{/each}}
      </section>

      {{!-- Persistent Damage Section --}}
      <section class="tat-block tat-persistent-damage-block">
        <div class="pf2e-block-head">
          <h3 class="tat-label">{{localize "pf2e.combatTools.persistentTitle"}}</h3>
          <button type="button" class="tat-btn-xs" data-action="persistent-add" title="{{localize "pf2e.combatTools.persistentAdd"}}">
            <i class="fa-solid fa-plus"></i> {{localize "pf2e.combatTools.persistentAdd"}}
          </button>
        </div>
        <div class="tat-persistent-list">
          {{#each persistentList}}
          <div class="tat-persistent-item" data-id="{{id}}">
            <span class="tat-persistent-formula"><strong>{{formula}}</strong></span>
            <span class="tat-tag tat-tag-damage-type">{{damageType}}</span>
            <span class="tat-persistent-dc"><small>DC {{dc}}</small></span>
            <button type="button" class="tat-icon" data-action="persistent-remove" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
          {{else}}
          <p class="tat-empty">{{localize "pf2e.combatTools.noPersistent"}}</p>
          {{/each}}
        </div>
      </section>
    </div>

    {{!-- ═══ 4. SKILLS TAB (PERÍCIAS & SABERES) ═══ --}}
    <div class="tat-panel tat-skills-panel" data-tab-content="skills">
      <section class="tat-block tat-skills">
        <h3 class="tat-label">{{localize "pf2e.sheets.tabs.skills"}}</h3>
        <div class="tat-skill-grid">
          {{#each skills}}
          <div class="tat-skill" data-key="{{key}}">
            <button type="button" class="tat-skill-rank-badge rank-{{rank}}" data-action="cycle-skill-rank" data-key="{{key}}" title="{{rankLabel}} ({{localize (concat "pf2e.ranks." rank)}}) — {{localize "pf2e.sheets.cycleRank"}}">
              <span class="tat-seal">{{rank}}</span>
              <span class="pf2e-rank-pips">
                {{#each pips}}<span class="pip{{#if filled}} on{{/if}}"></span>{{/each}}
              </span>
            </button>
            <button type="button" class="tat-skill-roll" data-action="roll-skill" data-key="{{key}}" title="{{localize labelKey}}">
              <span class="tat-skill-name">{{localize labelKey}}</span>
              <b class="tat-skill-mod">{{total}}</b>
            </button>
          </div>
          {{/each}}
        </div>

        {{#if lore}}
        <div class="tat-lore-list">
          {{#each lore}}
          <div class="tat-skill tat-lore" data-name="{{name}}">
            <button type="button" class="tat-skill-rank-badge rank-{{rank}}" data-action="cycle-lore-rank" data-name="{{name}}" title="{{rankLabel}} — {{localize "pf2e.sheets.cycleRank"}}">
              <span class="tat-seal">{{rank}}</span>
              <span class="pf2e-rank-pips">
                {{#each pips}}<span class="pip{{#if filled}} on{{/if}}"></span>{{/each}}
              </span>
            </button>
            <button type="button" class="tat-skill-roll" data-action="roll-lore" data-name="{{name}}">
              <span class="tat-skill-name">{{name}}</span>
              <b class="tat-skill-mod">{{total}}</b>
            </button>
            <button type="button" class="tat-icon" data-action="lore-remove" data-name="{{name}}" title="×"><i class="fa-solid fa-xmark"></i></button>
          </div>
          {{/each}}
        </div>
        {{/if}}
        <div class="tat-lore-add">
          <input class="tat-in" type="text" name="new-lore-name" placeholder="{{localize "pf2e.sheets.lore"}}" />
          <button type="button" class="tat-add" data-action="lore-add" title="{{localize "pf2e.sheets.add"}}"><i class="fa-solid fa-plus"></i></button>
        </div>
      </section>
    </div>

    {{!-- ═══ 5. SPELLS TAB ═══ --}}
    <div class="tat-panel pf2e-spells-panel" data-tab-content="spells">
      <div class="tat-casting pf2e-spell-casting-bar">
        <div class="pf2e-spell-stats-group">
          <div class="tat-tile tat-def">
            <strong class="tat-def-value">{{spellDC}}</strong>
            <span class="tat-def-name">{{localize "pf2e.sheets.spellDC"}}</span>
          </div>
          <div class="tat-tile tat-def">
            <button type="button" class="tat-def-value tat-roll" data-action="roll-spell-attack" title="{{localize "pf2e.sheets.rollSpellAttack"}}">{{spellAttack}}</button>
            <span class="tat-def-name">{{localize "pf2e.sheets.spellAttack"}}</span>
          </div>
        </div>
        <div class="pf2e-spell-controls-group">
          <div class="pf2e-spell-selectors">
            <div class="pf2e-spell-type-selector">
              <span class="tat-label-sm">{{localize "pf2e.spellcasting.spellcastingType"}}:</span>
              <select class="tat-select tat-select-sm" data-action="set-spellcasting-type">
                {{#each spellcastingTypes}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </div>
            <div class="pf2e-spell-tradition-selector">
              <span class="tat-label-sm">{{localize "pf2e.spellcasting.tradition"}}:</span>
              <select class="tat-select tat-select-sm" data-action="set-spellcasting-tradition">
                {{#each spellcastingTraditions}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </div>
          </div>
          <div class="pf2e-spell-rest-actions">
            <button type="button" class="tat-btn-xs" data-action="refocus" title="{{localize "pf2e.spellcasting.refocusTitle"}}">
              <i class="fa-solid fa-diamond"></i> {{localize "pf2e.spellcasting.refocus"}}
            </button>
            <button type="button" class="tat-btn-xs" data-action="daily-prep" title="{{localize "pf2e.spellcasting.dailyPrepTitle"}}">
              <i class="fa-solid fa-bed"></i> {{localize "pf2e.spellcasting.dailyPrep"}}
            </button>
          </div>
        </div>
      </div>
      {{#each spellsByRank}}
      <section class="tat-block pf2e-spell-rank-block">
        <h3 class="tat-label tat-label-row">{{localize "pf2e.sheets.rank"}} {{rank}}
          {{#if slots}}
          <span class="tat-slots">
            <button type="button" class="tat-icon-btn tat-slot-btn" data-action="slot-expend" data-rank="{{rank}}" title="{{localize "pf2e.spellcasting.useSlot"}}">−</button>
            <input class="tat-in tat-in-sm" type="number" name="sd:spellSlots.{{rank}}.value" value="{{slots.value}}" /> / <input class="tat-in tat-in-sm" type="number" name="sd:spellSlots.{{rank}}.max" value="{{slots.max}}" />
            <button type="button" class="tat-icon-btn tat-slot-btn" data-action="slot-recover" data-rank="{{rank}}" title="{{localize "pf2e.spellcasting.recoverSlot"}}">+</button>
          </span>
          {{/if}}
        </h3>

        {{!-- Prepared spell slots for this rank --}}
        {{#if ../isPreparedCaster}}
        {{#if hasPreparedSlots}}
        <div class="pf2e-prepared-slots-box">
          <div class="pf2e-prepared-slots-title">
            <i class="fa-solid fa-scroll"></i> {{localize "pf2e.spellcasting.preparedSlots"}}
          </div>
          <div class="pf2e-prepared-slots-grid">
            {{#each preparedSlots}}
            <div class="pf2e-prepared-slot-card{{#if expended}} is-expended{{/if}}">
              <span class="pf2e-slot-index">#{{slotNumber}}</span>
              {{#if hasSpell}}
              <button type="button" class="pf2e-prepared-slot-name" data-action="toggle-prepared-slot" data-rank="{{../rank}}" data-index="{{index}}" title="{{localize "pf2e.spellcasting.toggleExpended"}}">
                {{#if expended}}<s class="tat-dim">{{spellName}}</s>{{else}}<b>{{spellName}}</b>{{/if}}
              </button>
              <button type="button" class="tat-btn-xs tat-cast-slot-btn" data-action="cast-prepared-slot" data-rank="{{../rank}}" data-index="{{index}}" title="{{localize "pf2e.spellcasting.cast"}}"{{#if expended}} disabled{{/if}}>
                <i class="fa-solid fa-wand-magic-sparkles"></i>
              </button>
              <button type="button" class="tat-icon pf2e-unprepare-btn" data-action="unprepare-slot" data-rank="{{../rank}}" data-index="{{index}}" title="{{localize "pf2e.spellcasting.unprepareSlot"}}">
                <i class="fa-solid fa-xmark"></i>
              </button>
              {{else}}
              <select class="tat-select tat-select-sm pf2e-prepare-select" data-action="prepare-slot" data-rank="{{../rank}}" data-index="{{index}}">
                <option value="">— {{localize "pf2e.spellcasting.emptySlot"}} —</option>
                {{#each availableSpells}}
                <option value="{{id}}"{{#if isSelected}} selected{{/if}}>{{name}} (R{{baseRank}})</option>
                {{/each}}
              </select>
              {{/if}}
            </div>
            {{/each}}
          </div>
        </div>
        {{/if}}
        {{/if}}

        {{#if items.length}}
        <div class="pf2e-spellbook-heading tat-dim" style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; margin-top: 6px; margin-bottom: 2px;">
          <i class="fa-solid fa-book-open"></i> {{localize "pf2e.spellcasting.spellbook"}}
        </div>
        {{#each items}}
        <div class="tat-actionrow" data-id="{{id}}">
          <span class="tat-cost pf2e-glyph-cost">{{actions}}</span>
          <button type="button" class="tat-link" data-action="item-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{name}}</button>
          {{#if hasDamage}}
          <button type="button" class="tat-btn-xs tat-roll" data-action="roll-spell-damage" data-id="{{id}}" data-rank="{{../rank}}" title="{{damageFormula}}">
            <i class="fa-solid fa-burst"></i> {{damageFormula}}
          </button>
          {{/if}}
          <button type="button" class="tat-btn-xs tat-cast-btn" data-action="cast-spell" data-id="{{id}}" data-rank="{{../rank}}" title="{{localize "pf2e.spellcasting.cast"}}">
            <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "pf2e.spellcasting.cast"}}
          </button>
          <button type="button" class="tat-icon" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{/each}}
        {{/if}}
      </section>
      {{/each}}
      <button type="button" class="tat-add" data-action="item-create" data-type="spell"><i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addSpell"}}</button>
    </div>

    {{!-- ═══ 6. CRAFTING TAB (MANUFATURA & FÓRMULAS) ═══ --}}
    <div class="tat-panel tat-crafting-panel" data-tab-content="crafting">
      <section class="tat-block tat-crafting-header-block">
        <h3 class="tat-label">{{localize "pf2e.sheets.crafting"}}</h3>
        <div class="tat-craft-stats-grid">
          <div class="craft-stat-box">
            <span class="stat-lbl">{{localize "pf2e.sheets.craftingRank"}}</span>
            <span class="stat-val rank-badge">{{crafting.rankLabel}}</span>
          </div>
          <div class="craft-stat-box">
            <span class="stat-lbl">{{localize "pf2e.sheets.modifier"}}</span>
            <button type="button" class="tat-roll craft-roll-btn" data-action="roll-crafting" title="{{localize "pf2e.sheets.rollCrafting"}}">
              <i class="fa-solid fa-hammer"></i> <b>{{crafting.mod}}</b>
            </button>
          </div>
          <div class="craft-stat-box">
            <span class="stat-lbl">{{localize "pf2e.sheets.craftingDC"}}</span>
            <b class="stat-val dc-val">{{crafting.dc}}</b>
          </div>
          <div class="craft-stat-box">
            <span class="stat-lbl">{{localize "pf2e.sheets.infusedReagents"}}</span>
            <input class="tat-in tat-in-sm" type="number" name="sd:crafting.infusedReagents" value="{{crafting.infusedReagents}}" min="0" />
          </div>
        </div>
        <div class="pf2e-crafting-actions-bar" style="margin-top: 10px; display: flex; gap: 8px;">
          <button type="button" class="tat-btn-xs" data-action="downtime-craft">
            <i class="fa-solid fa-hammer"></i> {{localize "pf2e.downtime.craftTitle"}}
          </button>
          <button type="button" class="tat-btn-xs" data-action="downtime-earn-income">
            <i class="fa-solid fa-coins"></i> {{localize "pf2e.downtime.earnIncomeTitle"}}
          </button>
        </div>
      </section>

      <section class="tat-block tat-formulas-block">
        <div class="pf2e-block-head" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <h3 class="tat-label" style="margin:0;">{{localize "pf2e.sheets.knownFormulas"}}</h3>
          <button type="button" class="tat-btn-xs" data-action="item-create" data-type="formula" data-is-formula="true">
            <i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addFormula"}}
          </button>
        </div>
        <div class="pf2e-formulas-list">
          {{#each crafting.formulas}}
          <div class="tat-actionrow pf2e-formula-row" data-id="{{id}}">
            <span class="tat-cost pf2e-formula-level">{{localize "pf2e.sheets.level"}} {{level}}</span>
            <button type="button" class="tat-link pf2e-item-open-btn" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}">
              <i class="fa-solid fa-scroll"></i> {{name}}
            </button>
            {{#if price}}<span class="pf2e-inv-price">{{price}}</span>{{/if}}
            <button type="button" class="tat-icon" data-action="item-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}"><i class="fa-solid fa-message"></i></button>
            <button type="button" class="tat-icon" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}"><i class="fa-solid fa-pen-to-square"></i></button>
            <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-trash"></i></button>
          </div>
          {{else}}
          <p class="tat-empty">{{localize "pf2e.sheets.noFormulas"}}</p>
          {{/each}}
        </div>
      </section>
    </div>

    {{!-- ═══ 7. FEATS TAB (TALENTOS AUTÊNTICOS DO PF2E) ═══ --}}
    <div class="tat-panel pf2e-feats-panel" data-tab-content="feats">
      {{#each featCategories}}
      <section class="tat-block pf2e-feat-category-block">
        <div class="pf2e-block-head" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
          <h3 class="tat-label" style="margin:0;">{{label}}</h3>
          <button type="button" class="tat-btn-xs" data-action="item-create" data-type="feat" data-category="{{key}}">
            <i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.addFeat"}}
          </button>
        </div>
        <div class="pf2e-feats-list">
          {{#each items}}
          <div class="pf2e-feat-card" data-id="{{id}}">
            <div class="pf2e-feat-card-main">
              {{#if actions}}
              <span class="pf2e-glyph-box glyph-feat">{{actions}}</span>
              {{else}}
              <span class="pf2e-feat-icon"><i class="fa-solid fa-medal"></i></span>
              {{/if}}
              <div class="pf2e-feat-details">
                <div class="pf2e-feat-name-row">
                  <button type="button" class="pf2e-feat-name-btn" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}">
                    {{name}}
                  </button>
                  {{#if level}}<span class="pf2e-feat-level-tag">{{localize "pf2e.sheets.level"}} {{level}}</span>{{/if}}
                </div>
                {{#if traits.length}}
                <div class="pf2e-feat-traits">
                  {{#each traits}}<span class="pf2e-trait-tag">{{this}}</span>{{/each}}
                </div>
                {{/if}}
                {{#if desc}}<p class="pf2e-feat-desc">{{desc}}</p>{{/if}}
              </div>
            </div>
            <div class="pf2e-feat-actions">
              <button type="button" class="tat-icon" data-action="item-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">
                <i class="fa-solid fa-message"></i>
              </button>
              <button type="button" class="tat-icon" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
          {{else}}
          <p class="tat-empty">{{localize "pf2e.sheets.noFeats"}}</p>
          {{/each}}
        </div>
      </section>
      {{/each}}
    </div>

    {{!-- ═══ 8. INVENTORY TAB (TABELA DE INVENTÁRIO AUTÊNTICA PF2E) ═══ --}}
    <div class="tat-panel pf2e-inventory-panel" data-tab-content="inventory">
      {{#each inventory}}
      <section class="tat-block pf2e-inv-section">
        <div class="pf2e-inv-section-head">
          <h3 class="tat-label">{{localize labelKey}}</h3>
          <button type="button" class="tat-btn-xs" data-action="item-create" data-type="{{type}}">
            <i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.add"}}
          </button>
        </div>
        <table class="pf2e-inv-table">
          <thead>
            <tr>
              <th class="col-name">{{localize "pf2e.sheets.item"}}</th>
              <th class="col-level">{{localize "pf2e.sheets.level"}}</th>
              <th class="col-qty">{{localize "pf2e.sheets.quantity"}}</th>
              <th class="col-bulk">{{localize "pf2e.sheets.bulk"}}</th>
              <th class="col-price">{{localize "pf2e.sheets.price"}}</th>
              <th class="col-actions">{{localize "pf2e.sheets.actions"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each items}}
            <tr class="pf2e-inv-row" data-id="{{id}}">
              <td class="col-name">
                <div class="pf2e-inv-item-info">
                  {{#if hasImg}}
                  <img src="{{imgUrl}}" class="pf2e-inv-thumb" alt="" />
                  {{else}}
                  <span class="pf2e-inv-icon"><i class="{{imgUrl}}"></i></span>
                  {{/if}}
                  <button type="button" class="pf2e-inv-item-name" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}">
                    {{name}}
                  </button>
                </div>
              </td>
              <td class="col-level">{{#if level}}{{level}}{{else}}—{{/if}}</td>
              <td class="col-qty">
                <div class="pf2e-qty-control">
                  <button type="button" class="tat-icon-btn pf2e-qty-btn" data-action="item-qty-dec" data-id="{{id}}" title="−">−</button>
                  <span class="pf2e-qty-value">{{quantity}}</span>
                  <button type="button" class="tat-icon-btn pf2e-qty-btn" data-action="item-qty-inc" data-id="{{id}}" title="+">+</button>
                </div>
              </td>
              <td class="col-bulk">{{bulk}}</td>
              <td class="col-price">{{#if price}}{{price}}{{else}}—{{/if}}</td>
              <td class="col-actions">
                <div class="pf2e-inv-row-tools">
                  <button type="button" class="tat-icon pf2e-equip-toggle{{#if equipped}} is-equipped{{/if}}" data-action="item-toggle-equip" data-id="{{id}}" title="{{#if equipped}}{{localize "pf2e.sheets.equipped"}}{{else}}{{localize "pf2e.sheets.unequipped"}}{{/if}}">
                    <i class="fa-solid {{#if equipped}}fa-shield-halved{{else}}fa-shield{{/if}}"></i>
                  </button>
                  <button type="button" class="tat-icon" data-action="item-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">
                    <i class="fa-solid fa-message"></i>
                  </button>
                  <button type="button" class="tat-icon" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                  <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
            {{else}}
            <tr class="pf2e-inv-empty-row">
              <td colspan="6" class="tat-empty">{{localize "pf2e.sheets.emptyCategory"}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>
      {{/each}}
    </div>

    {{!-- ═══ 9. NOTES TAB ═══ --}}
    <div class="tat-panel" data-tab-content="notes">
      <textarea class="tat-in tat-notes" name="sd:details.biography" placeholder="{{localize "pf2e.sheets.notesPlaceholder"}}">{{biography}}</textarea>
    </div>

    {{!-- ═══ 10. EFFECTS TAB ═══ --}}
    <div class="tat-panel tat-effects-panel" data-tab-content="effects">
      <section class="tat-block">
        <h3 class="tat-label">{{localize "pf2e.sheets.appliedEffects"}}</h3>
        <div class="tat-effects-list">
          {{#each effectItems}}
          <div class="tat-actionrow tat-effect-row" data-id="{{id}}">
            <div class="tat-effect-info">
              <span class="tat-effect-name"><strong>{{name}}</strong></span>
              {{#if duration}}<span class="tat-tag tat-tag-duration"><i class="fa-solid fa-clock"></i> {{duration}}</span>{{/if}}
              <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
            {{#if traits.length}}
            <div class="tat-effect-selectors">
              {{#each traits}}<span class="tat-tag">{{this}}</span>{{/each}}
            </div>
            {{/if}}
          </div>
          {{else}}
          <p class="tat-empty">{{localize "pf2e.sheets.noEffectItems"}}</p>
          {{/each}}
        </div>
      </section>

      <section class="tat-block">
        <h3 class="tat-label">{{localize "pf2e.sheets.activeModifiers"}}</h3>
        <div class="tat-effects-list">
          {{#each ruleModifiers}}
          <div class="tat-actionrow tat-effect-row">
            <div class="tat-effect-info">
              <span class="tat-effect-name"><strong>{{label}}</strong></span>
              <span class="tat-tag tat-tag-type">{{type}}</span>
              <span class="tat-effect-val"><b>{{fmtValue}}</b></span>
            </div>
            <div class="tat-effect-selectors">
              {{#each selectors}}<span class="tat-tag">{{this}}</span>{{/each}}
            </div>
          </div>
          {{else}}
          <p class="tat-empty">{{localize "pf2e.sheets.noEffects"}}</p>
          {{/each}}
        </div>
      </section>

      <section class="tat-block">
        <h3 class="tat-label">{{localize "pf2e.sheets.derivedResistances"}}</h3>
        <div class="tat-mitigation-tags">
          {{#each derivedResistancesList}}
          <span class="tat-tag">{{type}}: {{value}}</span>
          {{else}}
          <p class="tat-empty">{{localize "pf2e.sheets.noResistances"}}</p>
          {{/each}}
        </div>
      </section>

      <section class="tat-block">
        <h3 class="tat-label">{{localize "pf2e.sheets.derivedWeaknesses"}}</h3>
        <div class="tat-mitigation-tags">
          {{#each derivedWeaknessesList}}
          <span class="tat-tag">{{type}}: {{value}}</span>
          {{else}}
          <p class="tat-empty">{{localize "pf2e.sheets.noWeaknesses"}}</p>
          {{/each}}
        </div>
      </section>
    </div>
    </div>
  </div>
</div>


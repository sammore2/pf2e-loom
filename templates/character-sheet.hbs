              <button type="button" class="tat-btn-xs" data-action="item-create" data-type="action" data-cost="2">
                <i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.createAction"}}
              </button>
              <button type="button" class="tat-btn-xs pf2e-browser-launch-btn" data-action="open-compendium" data-tab="actions">
                <i class="fa-solid fa-book"></i> {{localize "pf2e.sheets.browse"}}
              </button>
            </div>
          </div>
          <div class="pf2e-actions-list">
            {{#each activities}}
            <div class="pf2e-action-item-card" data-id="{{id}}">
              <button type="button" class="pf2e-glyph-box glyph-act" data-action="action-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{actions}}</button>
              <div class="pf2e-action-details">
                <button type="button" class="pf2e-action-name" data-action="action-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}">{{name}}</button>
                {{#if traits.length}}
                <div class="pf2e-action-traits">{{#each traits}}<span class="tat-tag">{{this}}</span>{{/each}}</div>
                {{/if}}
              </div>
              <div class="pf2e-action-tools">
                <button type="button" class="tat-icon" data-action="action-chat" data-id="{{id}}" title="{{localize "pf2e.sheets.sendToChat"}}"><i class="fa-solid fa-message"></i></button>
                <button type="button" class="tat-icon" data-action="item-open" data-id="{{id}}" title="{{localize "pf2e.sheets.edit"}}"><i class="fa-solid fa-pen-to-square"></i></button>
                <button type="button" class="tat-icon" data-action="item-delete" data-id="{{id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-trash"></i></button>

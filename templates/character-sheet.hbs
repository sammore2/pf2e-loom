{{!-- PF2E — Character Sheet: Practical Tabletop Remaster UX with Persistent Survival Rail --}}
<div class="pf2e-panel tat-hud pf2e-remaster-sheet">

  {{!-- ═════ PERSISTENT LEFT TACTICAL SURVIVAL RAIL ═════ --}}
  <aside class="tat-rail">

    {{!-- 0. Heraldic Ruleset Cartouche --}}
    <div class="tat-rail-logo-banner">
      <span class="tat-rail-logo-txt">PF2e</span>
    </div>

    {{!-- 1. Hit Points, Dying & Wounded Tracks, Rest Button --}}
    <section class="tat-block tat-hp-card{{#if hp.low}} is-low{{/if}}">
      <div class="tat-label tat-label-row">
        <span>{{localize "pf2e.sheets.hp"}}</span>
        <button type="button" class="tat-rest-btn" data-action="rest-recovery" title="{{localize "pf2e.sheets.restFull"}}">
          <i class="fa-solid fa-bed"></i>
        </button>
      </div>

      <div class="tat-hp-3col">
        <div class="hp-stat-cell hp-stat-temp">
          <span class="hp-stat-lbl">{{localize "pf2e.sheets.temp"}}</span>
          <input class="tat-in tat-in-sm hp-stat-in" type="number" name="sd:hp.temp" value="{{hp.temp}}" title="{{localize "pf2e.sheets.tempHp"}}" />
        </div>
        <div class="hp-stat-cell hp-stat-cur">
          <span class="hp-stat-lbl">{{localize "pf2e.sheets.current"}}</span>
          <input class="tat-in tat-hp-cur hp-stat-in" type="number" name="sd:hp.value" value="{{hp.value}}" title="{{localize "pf2e.sheets.currentHp"}}" />
        </div>
        <div class="hp-stat-cell hp-stat-max">
          <span class="hp-stat-lbl">{{localize "pf2e.sheets.max"}}</span>
          <input class="tat-in tat-in-sm hp-stat-in" type="number" name="sd:hp.max" value="{{hp.max}}" title="{{localize "pf2e.sheets.maxHp"}}" />
        </div>
      </div>
      <div class="tat-hp-bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{hp.pct}}">
        <div class="tat-hp-fill" style="width: {{hp.pct}}%"></div>
      </div>

      {{!-- Dying & Wounded Pip Tracks --}}
      <div class="pf2e-vital-tracks">
        <div class="pf2e-vital-track" title="{{localize "pf2e.sheets.dyingHint"}}">
          <span class="track-lbl">{{localize "pf2e.conditions.dying"}}</span>
          <div class="track-pips">
            {{#each dyingDots}}
            <button type="button" class="vital-pip{{#if filled}} on is-dying{{/if}}" data-action="set-dying" data-value="{{n}}" title="Dying {{n}}">●</button>
            {{/each}}
          </div>
        </div>
        <div class="pf2e-vital-track" title="{{localize "pf2e.sheets.woundedHint"}}">
          <span class="track-lbl">{{localize "pf2e.conditions.wounded"}}</span>
          <div class="track-pips">
            {{#each woundedDots}}
            <button type="button" class="vital-pip{{#if filled}} on is-wounded{{/if}}" data-action="set-wounded" data-value="{{n}}" title="Wounded {{n}}">●</button>
            {{/each}}
          </div>
        </div>
      </div>

      {{!-- Quick HP Actions: Damage, Heal, Recovery --}}
      <div class="pf2e-hp-actions">
        <button type="button" class="tat-btn-xs" data-action="apply-damage" title="{{localize "pf2e.combatTools.damageTitle"}}">
          <i class="fa-solid fa-burst"></i> {{localize "pf2e.combatTools.damage"}}
        </button>
        <button type="button" class="tat-btn-xs" data-action="apply-healing" title="{{localize "pf2e.combatTools.healTitle"}}">
          <i class="fa-solid fa-heart-pulse"></i> {{localize "pf2e.combatTools.heal"}}
        </button>
        {{#if isDying}}
        <button type="button" class="tat-btn-xs tat-btn-danger" data-action="recovery-check" title="{{localize "pf2e.combatTools.recovery"}}">
          <i class="fa-solid fa-skull"></i> {{localize "pf2e.combatTools.recovery"}}
        </button>
        <button type="button" class="tat-btn-xs tat-btn-warning" data-action="heroic-recovery" title="{{localize "pf2e.spellcasting.heroicRecovery"}}">
          <i class="fa-solid fa-shield-heart"></i> {{localize "pf2e.spellcasting.heroicRecovery"}}
        </button>
        {{/if}}
      </div>
    </section>

    {{!-- 2. Armor Class Heraldic Shield & Physical Shield --}}
    <section class="tat-block tat-ac-card">
      <div class="tat-label tat-label-row">
        <span>{{localize "pf2e.sheets.short.ac"}}</span>
        <button type="button" class="tat-rail-tag-btn" data-action="roll-check" title="{{localize "pf2e.sheets.modifiers"}}">Mod</button>
      </div>
      <div class="tat-ac-crest-wrap">
        <div class="tat-blue-shield rank-{{acTile.rank}}">
          <button type="button" class="tat-shield-seal-btn" data-action="cycle-defense-rank" data-path="armor.rank" title="{{acTile.rankLabel}} — {{localize "pf2e.sheets.cycleRank"}}">
            {{acTile.rank}}
          </button>
          <strong class="tat-shield-ac-val">{{ac}}</strong>
          <span class="tat-shield-ac-lbl">{{localize "pf2e.sheets.short.ac"}}</span>
        </div>
        <div class="tat-equipped-shield" title="{{#if shield}}{{shield.name}}{{else}}{{localize "pf2e.sheets.noShield"}}{{/if}}">
          <div class="shield-stat-mini">
            <span class="shield-lbl">{{localize "pf2e.sheets.hardness"}}</span>
            <b class="shield-val">{{#if shield}}{{shield.hardness}}{{else}}—{{/if}}</b>
          </div>
          <div class="shield-stat-mini">
            <span class="shield-lbl">{{localize "pf2e.sheets.shieldHp"}}</span>
            <b class="shield-val">{{#if shield}}{{shield.hp.value}}/{{shield.hp.max}}{{else}}—{{/if}}</b>
          </div>
          {{#if shield.isBroken}}<span class="shield-broken-tag">{{localize "pf2e.sheets.broken"}}</span>{{/if}}
        </div>
      </div>
    </section>

    {{!-- 3. Perception & Initiative Dock --}}
    <section class="tat-block pf2e-rail-stats-card">
      {{!-- Perception Row --}}
      <div class="pf2e-rail-stat-section">
        <div class="stat-sec-head">
          <span class="tat-label">{{localize "pf2e.defenses.perception"}}</span>
        </div>
        <div class="stat-sec-row">
          <button type="button" class="stat-roll-badge tat-roll" data-action="roll-perception" title="{{localize "pf2e.defenses.perception"}} — {{localize "pf2e.sheets.roll"}}">
            <i class="fa-solid fa-dice-d20"></i>
            <b class="stat-roll-val">{{perc}}</b>
          </button>
          <button type="button" class="stat-rank-tag tat-seal-pill" data-action="cycle-defense-rank" data-path="perception.rank" title="{{perceptionTile.rankLabel}} — {{localize "pf2e.sheets.cycleRank"}}">
            {{perceptionTile.shortRankLabel}}
          </button>
        </div>
        <div class="senses-pill-group" data-action="edit-senses" title="{{localize "pf2e.sheets.editSenses"}}">
          <span class="senses-tag-lbl"><i class="fa-solid fa-eye"></i> {{localize "pf2e.sheets.sensesLabel"}}:</span>
          <span class="senses-tag-list">{{#each senses}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</span>
          <i class="fa-solid fa-pen-to-square"></i>
        </div>
      </div>

      {{!-- Initiative Row --}}
      <div class="pf2e-rail-stat-section">
        <div class="stat-sec-head">
          <span class="tat-label">{{localize "pf2e.sheets.initiative"}}</span>
        </div>
        <div class="stat-sec-row">
          <button type="button" class="stat-roll-badge tat-roll init-badge" data-action="roll-initiative" title="{{localize "pf2e.sheets.initiative"}} — {{localize "pf2e.sheets.roll"}}">
            <i class="fa-solid fa-dice-d20"></i>
            <b class="stat-roll-val">{{initiativeTotal}}</b>
          </button>
          <select class="init-skill-select" name="sd:initiative.skill" title="{{localize "pf2e.sheets.initiativeSkill"}}">
            {{#each initiativeSkills}}
            <option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    </section>

    {{!-- 4. Saving Throws Triad: Fortitude, Reflex, Will (3-Column Tablet) --}}
    <section class="tat-block tat-saves-card">
      <div class="tat-row-header">
        <h3 class="tat-label">{{localize "pf2e.sheets.saves"}}</h3>
      </div>
      <div class="tat-saves-3col">
        {{#each saveTiles}}
        <div class="tat-save-col rank-{{rank}}">
          <span class="save-col-name">{{localize shortKey}}</span>
          <button type="button" class="tat-seal-pill" data-action="cycle-defense-rank" data-path="{{path}}" title="{{rankLabel}} — {{localize "pf2e.sheets.cycleRank"}}">{{rankLetter}}</button>
          <button type="button" class="tat-save-badge-btn tat-roll" data-action="roll-save" data-key="{{key}}" title="{{localize labelKey}} — {{localize "pf2e.sheets.roll"}}">
            <i class="fa-solid fa-dice-d20"></i>
            <b class="save-val">{{value}}</b>
          </button>
        </div>
        {{/each}}
      </div>
    </section>

    {{!-- 5. Mitigations (Immunities, Weaknesses, Resistances) --}}
    <section class="tat-block tat-mitigations-card">
      <div class="tat-mitigation-row">
        <span class="mit-label">{{localize "pf2e.sheets.immunities"}}</span>
        <div class="mit-tags">{{#each immunities}}<span class="tat-tag">{{this}}</span>{{else}}<span class="mit-empty">—</span>{{/each}}</div>
        <button type="button" class="tat-icon-btn" data-action="edit-mitigations" data-type="immunities" title="{{localize "pf2e.sheets.editImmunities"}}"><i class="fa-solid fa-pen-to-square"></i></button>
      </div>
      <div class="tat-mitigation-row">
        <span class="mit-label">{{localize "pf2e.sheets.weaknesses"}}</span>
        <div class="mit-tags">{{#each weaknesses}}<span class="tat-tag">{{this}}</span>{{else}}<span class="mit-empty">—</span>{{/each}}</div>
        <button type="button" class="tat-icon-btn" data-action="edit-mitigations" data-type="weaknesses" title="{{localize "pf2e.sheets.editWeaknesses"}}"><i class="fa-solid fa-pen-to-square"></i></button>
      </div>
      <div class="tat-mitigation-row">
        <span class="mit-label">{{localize "pf2e.sheets.resistances"}}</span>
        <div class="mit-tags">{{#each resistances}}<span class="tat-tag">{{this}}</span>{{else}}<span class="mit-empty">—</span>{{/each}}</div>
        <button type="button" class="tat-icon-btn" data-action="edit-mitigations" data-type="resistances" title="{{localize "pf2e.sheets.editResistances"}}"><i class="fa-solid fa-pen-to-square"></i></button>
      </div>
    </section>

    {{!-- 6. Active Conditions Pill Stack --}}
    <section class="tat-block tat-conditions-card">
      <h3 class="tat-label">{{localize "pf2e.sheets.conditions"}}</h3>
      <div class="tat-condition-tags">
        {{#each conditionsActive}}
        <span class="tat-cond">
          <span class="tat-cond-name">{{localize labelKey}}</span>
          {{#if valued}}
          <button type="button" data-action="cond-dec" data-id="{{id}}" title="−">−</button><b>{{value}}</b><button type="button" data-action="cond-inc" data-id="{{id}}" title="+">+</button>
          {{else}}
          <button type="button" data-action="cond-remove" data-id="{{id}}" title="×"><i class="fa-solid fa-xmark"></i></button>
          {{/if}}
        </span>
        {{else}}
        <p class="tat-empty">{{localize "pf2e.sheets.noConditions"}}</p>
        {{/each}}
      </div>
      {{#if conditionOptions}}
      <select class="tat-in tat-cond-add" data-action="cond-add">
        <option value="">+ {{localize "pf2e.sheets.addCondition"}}</option>
        {{#each conditionOptions}}<option value="{{value}}">{{localize labelKey}}</option>{{/each}}
      </select>
      {{/if}}
    </section>

    {{!-- Heraldic Banner Tail Flourish at Bottom --}}
    <div class="tat-banner-tail" aria-hidden="true">
      <svg viewBox="0 0 240 36" preserveAspectRatio="none">
        <path d="M 0 0 L 0 12 C 30 18, 50 32, 68 32 C 86 32, 98 22, 120 34 C 142 22, 154 32, 172 32 C 190 32, 210 18, 240 12 L 240 0 Z" fill="#3b090a" stroke="#a47c34" stroke-width="1.5"></path>
        <path d="M 38 18 C 48 30, 62 30, 72 20 C 76 16, 70 12, 60 14 C 50 16, 44 24, 52 28" fill="#f8f1df" stroke="#785020" stroke-width="1.2"></path>
        <path d="M 202 18 C 192 30, 178 30, 168 20 C 164 16, 170 12, 180 14 C 190 16, 196 24, 188 28" fill="#f8f1df" stroke="#785020" stroke-width="1.2"></path>
      </svg>
    </div>
  </aside>

  {{!-- ═════ RIGHT MAIN CONTENT AREA ═════ --}}
  <div class="tat-main">

    {{!-- Top Header: Identity, Level Crest, XP Track, Hero Points --}}
    <header class="tat-head">
      <div class="tat-id">
        <input class="tat-in tat-name" type="text" name="name" value="{{name}}" placeholder="{{localize "pf2e.sheets.name"}}" />
        <div class="tat-id-badges-line">
          {{#if identity.ancestry}}
          <button type="button" class="tat-id-badge" data-action="item-open" data-id="{{identity.ancestry.id}}" title="{{localize "pf2e.itemTypes.ancestry"}}">{{identity.ancestry.name}}</button>
          {{/if}}
          {{#if identity.heritage}}
          <button type="button" class="tat-id-badge" data-action="item-open" data-id="{{identity.heritage.id}}" title="{{localize "pf2e.itemTypes.heritage"}}">{{identity.heritage.name}}</button>
          {{/if}}
          {{#if identity.class}}
          <button type="button" class="tat-id-badge tat-id-badge-class" data-action="item-open" data-id="{{identity.class.id}}" title="{{localize "pf2e.itemTypes.class"}}">{{identity.class.name}} {{level}}</button>
          {{/if}}
          {{#if identity.background}}
          <button type="button" class="tat-id-badge" data-action="item-open" data-id="{{identity.background.id}}" title="{{localize "pf2e.itemTypes.background"}}">{{identity.background.name}}</button>
          {{/if}}
        </div>
        <div class="tat-hero-header" title="{{localize "pf2e.sheets.hero"}}">
          <span class="tat-hero-lbl">{{localize "pf2e.sheets.hero"}}</span>
          <div class="tat-hero-shields">
            {{#each heroDots}}
            <button type="button" class="tat-hero-shield{{#if filled}} on{{/if}}" data-action="set-hero" data-value="{{n}}" title="{{localize "pf2e.sheets.hero"}} {{n}}">
              <i class="fa-solid fa-shield"></i>
            </button>
            {{/each}}
          </div>
          <button type="button" class="tat-btn-xs pf2e-spend-hero-btn" data-action="spend-hero-point" title="{{localize "pf2e.spellcasting.spendHeroPoint"}}">
            <i class="fa-solid fa-star"></i> {{localize "pf2e.spellcasting.spendHeroPoint"}}
          </button>
        </div>
      </div>

      <div class="tat-head-right">
        <div class="tat-level-badge" title="{{localize "pf2e.sheets.level"}}">
          <span class="lvl-lbl">{{localize "pf2e.sheets.level"}}</span>
          <input class="tat-in lvl-in" type="number" name="sd:level" value="{{level}}" min="1" max="20" />
        </div>
        <div class="tat-xp-col">
          <div class="tat-xp{{#if xp.ready}} is-ready{{/if}}" title="{{localize "pf2e.sheets.xpHint"}}">
            <div class="tat-xp-bar"><span style="width: {{xp.pct}}%"></span></div>
            <span class="tat-xp-read"><input class="tat-in tat-in-sm" type="number" name="sd:xp.value" value="{{xp.value}}" /> / {{xp.next}}</span>
          </div>
          <button type="button" class="tat-btn-xs tat-levelup-btn{{#if xp.ready}} tat-btn-warning{{/if}}" data-action="level-up" title="{{localize "pf2e.levelup.title"}}">
            <i class="fa-solid fa-arrow-up"></i> {{localize "pf2e.levelup.button"}}
          </button>
        </div>
      </div>
    </header>

    {{!-- Fixed Attribute Modifiers Ribbon (Remaster Primary Statistics) --}}
    <section class="tat-block tat-attributes-ribbon tat-fixed-attrs">
      <div class="pf2e-section-head">
        <h3 class="tat-label">{{localize "pf2e.sheets.attributes"}}</h3>
      </div>
      <div class="tat-attr-ribbon-grid">
        {{#each abilities}}
        <div class="tat-ribbon-cell" data-key="{{key}}">
          <div class="tat-ribbon-header-line">
            <button type="button" class="tat-ribbon-key-btn" data-action="roll-attribute" data-key="{{key}}" title="{{localize labelKey}} — {{localize "pf2e.sheets.rollCheck"}}">
              <span class="tat-attr-abbr">{{localize (concat "pf2e.sheets.abbr." key)}}</span>
              <i class="fa-solid fa-dice-d20 tat-attr-dice-icon" aria-hidden="true"></i>
            </button>
            {{#if isKeyAttr}}<i class="fa-solid fa-key tat-key-attr-icon" title="{{localize "pf2e.sheets.keyAttribute"}}"></i>{{/if}}
          </div>
          <div class="tat-ribbon-val-box">
            <input class="tat-in tat-attr-mod" type="text" name="sd:abilities.{{key}}.value" value="{{modFmt}}" title="{{localize labelKey}} {{localize "pf2e.sheets.modifier"}}" />
          </div>
        </div>
        {{/each}}
      </div>
    </section>

    {{!-- Navy Tab Strip with Heraldic Circular Icons --}}
    <nav class="tat-tabs">
      <span class="tat-active-tab-title">{{currentTabLabel}}</span>
      <div class="tat-tab-icons">
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="overview" title="{{localize "pf2e.sheets.tabs.overview"}}">
          <i class="fa-solid fa-id-card"></i>
        </button>
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="actions" title="{{localize "pf2e.sheets.tabs.actions"}}">
          <i class="fa-solid fa-person-running"></i>
        </button>
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="combat" title="{{localize "pf2e.sheets.tabs.combat"}}">
          <i class="fa-solid fa-shield-halved"></i>
        </button>
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="skills" title="{{localize "pf2e.sheets.tabs.skills"}}">
          <i class="fa-solid fa-book-bookmark"></i>
        </button>
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="spells" title="{{localize "pf2e.sheets.tabs.spells"}}">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
        </button>
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="crafting" title="{{localize "pf2e.sheets.tabs.crafting"}}">
          <i class="fa-solid fa-hammer"></i>
        </button>
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="feats" title="{{localize "pf2e.sheets.tabs.feats"}}">
          <i class="fa-solid fa-award"></i>
        </button>
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="inventory" title="{{localize "pf2e.sheets.tabs.inventory"}}">
          <i class="fa-solid fa-box-archive"></i>
        </button>
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="notes" title="{{localize "pf2e.sheets.tabs.notes"}}">
          <i class="fa-solid fa-feather-pointed"></i>
        </button>
        <button type="button" class="pf2e-tab-btn" data-action="tab" data-tab="effects" title="{{localize "pf2e.sheets.tabs.effects"}}">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
        </button>
        <button type="button" class="pf2e-tab-btn pf2e-browser-launch-btn" data-action="open-compendium" title="{{localize "pf2e.sheets.compendiumBrowser"}}">
          <i class="fa-solid fa-book"></i>
        </button>
      </div>
    </nav>

    {{!-- Scrollable Tab Body Area (Rolagem apenas no bloco da aba ativa) --}}
    <div class="tat-tab-body">

    {{!-- ═══ 1. OVERVIEW TAB (PERSONAGEM & DETALHES) ═══ --}}
    <div class="tat-panel tat-overview-panel" data-tab-content="overview">
      {{!-- Character Dossier Card: Identity Details & Demographics --}}
      <section class="tat-block tat-profile-card">
        <div class="profile-card-inner">
          <button type="button" class="tat-portrait-frame" data-action="pick-portrait" title="{{localize "pf2e.sheets.portrait"}}">
            <img src="{{avatarUrl}}" alt="{{name}}" onerror="this.src='/marketplace/rulesets/pf2e/assets/images/default-avatar.svg'" />
          </button>
          <div class="profile-details">
            <div class="profile-traits-row">
              <button type="button" class="tat-btn-xs tat-builder-launch-btn" data-action="open-character-builder" title="{{localize "pf2e.builder.title"}}">
                <i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "pf2e.builder.title"}}
              </button>
              {{#each traitsList}}
              <span class="tat-trait-badge">{{this}}</span>
              {{/each}}
            </div>
            <div class="profile-identity-grid">
              <div class="identity-item">
                <span class="id-lbl">{{localize "pf2e.itemTypes.ancestry"}}:</span>
                {{#if identity.ancestry}}
                <div class="tat-identity-pill-group">
                  <button type="button" class="tat-pill-btn" data-action="item-open" data-id="{{identity.ancestry.id}}">{{identity.ancestry.name}}</button>
                  <button type="button" class="tat-pill-del" data-action="item-delete" data-id="{{identity.ancestry.id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-xmark"></i></button>
                </div>
                {{else}}
                <button type="button" class="tat-pill-add" data-action="item-create" data-type="ancestry" title="{{localize "pf2e.sheets.add"}}">
                  <i class="fa-solid fa-plus"></i> {{localize "pf2e.itemTypes.ancestry"}}
                </button>
                {{/if}}
              </div>
              <div class="identity-item">
                <span class="id-lbl">{{localize "pf2e.itemTypes.heritage"}}:</span>
                {{#if identity.heritage}}
                <div class="tat-identity-pill-group">
                  <button type="button" class="tat-pill-btn" data-action="item-open" data-id="{{identity.heritage.id}}">{{identity.heritage.name}}</button>
                  <button type="button" class="tat-pill-del" data-action="item-delete" data-id="{{identity.heritage.id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-xmark"></i></button>
                </div>
                {{else}}
                <button type="button" class="tat-pill-add" data-action="item-create" data-type="heritage" title="{{localize "pf2e.sheets.add"}}">
                  <i class="fa-solid fa-plus"></i> {{localize "pf2e.itemTypes.heritage"}}
                </button>
                {{/if}}
              </div>
              <div class="identity-item">
                <span class="id-lbl">{{localize "pf2e.itemTypes.background"}}:</span>
                {{#if identity.background}}
                <div class="tat-identity-pill-group">
                  <button type="button" class="tat-pill-btn" data-action="item-open" data-id="{{identity.background.id}}">{{identity.background.name}}</button>
                  <button type="button" class="tat-pill-del" data-action="item-delete" data-id="{{identity.background.id}}" title="{{localize "pf2e.sheets.delete"}}"><i class="fa-solid fa-xmark"></i></button>
                </div>
                {{else}}

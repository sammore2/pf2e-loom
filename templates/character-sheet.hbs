            </div>
            {{else}}
            <div class="tat-empty pf2e-actions-empty">
              <span>{{localize "pf2e.sheets.noActivities"}}</span>
            </div>
            {{/each}}
          </div>
        </section>

        {{!-- Reactions Section --}}
        <section class="tat-block pf2e-actions-block">
          <div class="pf2e-block-head">
            <h3 class="tat-label">{{localize "pf2e.sheets.reactions"}}</h3>
            <div class="pf2e-head-btns">
              <button type="button" class="tat-btn-xs" data-action="item-create" data-type="action" data-cost="reaction">
                <i class="fa-solid fa-plus"></i> {{localize "pf2e.sheets.createReaction"}}
